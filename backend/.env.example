# Application
APP_NAME=Health Check System
DEBUG=false

# Redis (broker + cache)
# "redis" resolves to hc-redis container inside hc_net.
# No host port exposed — oe-redis-1 already owns 6379 on this machine.
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# PostgreSQL (optional — for persistent audit logs)
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/healthcheck

# Security — CHANGE THESE before deploying
ENCRYPTION_KEY=replace-with-32-char-random-secret-key
SECRET_KEY=replace-with-another-32-char-secret-key

# SSH defaults
SSH_TIMEOUT=30
SSH_CONNECT_TIMEOUT=10

# API defaults
API_TIMEOUT=30
API_RETRY_COUNT=3

# Cache TTL in seconds
CACHE_TTL=10
